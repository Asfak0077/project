# AWS RDS MySQL Database Configuration Example
DB_HOST=your-rds-endpoint.xxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your_aws_rds_master_password
DB_NAME=my_project

# Full SQLAlchemy Database URL
DATABASE_URL=mysql+pymysql://admin:your_aws_rds_master_password@your-rds-endpoint.xxxxxx.us-east-1.rds.amazonaws.com:3306/my_project?charset=utf8mb4

# Security & Application Settings
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
LLM_API_KEY=your_gemini_api_key
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
CSV_DATASET_PATH=../data/optimized_laptops.csv
DOCUMENTS_STORAGE_PATH=../documents
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
