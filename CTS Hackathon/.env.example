# AWS RDS MySQL Database Configuration Example
# Replace placeholders with your AWS RDS instance details
DB_HOST=your-rds-endpoint.xxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your_aws_rds_master_password
DB_NAME=my_project

# Connection Pool Settings
DB_POOL_NAME=aws_rds_pool
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT=10

# Security & Application Settings
JWT_SECRET=your_super_secret_jwt_key
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
