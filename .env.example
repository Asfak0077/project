# ===================================================
# VersusAI - Production Environment Configuration
# ===================================================

# 1. Database Connection (AWS RDS MySQL / Local)
DB_HOST=your-rds-endpoint.xxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your_secure_db_password
DB_NAME=my_project

# Full SQLAlchemy Database URL
DATABASE_URL=mysql+pymysql://admin:your_secure_db_password@your-rds-endpoint.xxxxxx.us-east-1.rds.amazonaws.com:3306/my_project?charset=utf8mb4

# 2. Security & JWT
JWT_SECRET=your_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 3. AI & LLM Keys
LLM_API_KEY=your_gemini_api_key_here

# 4. Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 5. Application & Network
DOMAIN=yourdomain.com
NEXT_PUBLIC_API_URL=/api
