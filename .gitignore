# 1. Environment & Secret Variables (CRITICAL)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
global-bundle.pem

# 2. Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 3. Node.js & Frontend Build Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts

# 4. Storage, Uploads, Vectors & Databases
uploads/
backend/uploads/
*.db
*.sqlite
*.sqlite3
product_assistant.db
chroma/
vectorstore/
vector_db/
backups/

# 5. OS & IDE Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# 6. Test & Coverage Output
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.pytest_cache/
